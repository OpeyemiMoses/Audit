{
  "name": "audit",
  "version": "1.0.0",
  "description": "The Intelligence & Security Layer for Binance Agent OS — Multi-Agent Risk, Token, Contract, and Market Intelligence",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "mcp": "tsx src/mcp-server.ts",
    "start:mcp": "node dist/mcp-server.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "binance",
    "agent-os",
    "mcp",
    "security",
    "audit",
    "ai",
    "bnb-chain",
    "intelligence",
    "trading"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "groq-sdk": "^0.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "viem": "^2.21.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "nodemon": "^3.1.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
